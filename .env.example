# OpenAI-compatible API configuration. Do not commit real credentials.
SKILL_MAS_API_KEY=replace-with-your-api-key
SKILL_MAS_BASE_URL=https://your-openai-compatible-endpoint/v1
SKILL_MAS_AGENT_LLM=gpt-5.6-luna

# Optional: use an existing env file with run_single_training.sh.
# SKILL_MAS_ENV_FILE=/absolute/path/to/provider.env

# External benchmark roots. Set only the dataset you are running.
# SKILL_MAS_GAIA_ROOT=/absolute/path/to/gaia
# SKILL_MAS_LOCOBENCH_ROOT=/absolute/path/to/locobench
# SKILL_MAS_LOCA_ROOT=/absolute/path/to/loca
# SKILL_MAS_BEYONDSWE_ROOT=/absolute/path/to/beyondswe
